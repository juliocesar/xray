{
  "name": "@julio_ody/xray",
  "version": "0.1.0",
  "description": "A tiny local relay: buffer labeled runtime events from any process and drain them to x-ray a scenario from the inside.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocesar/xray.git",
    "directory": "packages/relay"
  },
  "homepage": "https://github.com/juliocesar/xray#readme",
  "bugs": "https://github.com/juliocesar/xray/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "xray": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [
    "debug",
    "relay",
    "observability",
    "devtools",
    "claude",
    "agent"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
