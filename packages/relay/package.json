{
  "name": "xray",
  "version": "0.1.0",
  "description": "A tiny local debug relay: buffer labeled runtime events from any process and drain them to x-ray a scenario from the inside.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xray": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": [
    "debug",
    "relay",
    "observability",
    "devtools",
    "claude",
    "agent"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
